PREFIX atlas: <https://rinf-atlas.matdata.eu/ns#>
PREFIX view:  <https://rinf-atlas.matdata.eu/views/>
PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX era:   <http://data.europa.eu/949/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX level: <http://data.europa.eu/949/concepts/ten-t-network-levels/>
PREFIX traffic: <http://data.europa.eu/949/concepts/traffic-types/>
PREFIX cls:   <http://data.europa.eu/949/concepts/contact-line-systems/>
PREFIX etcs:  <http://data.europa.eu/949/concepts/etcs-levels/>
PREFIX lclc:  <http://data.europa.eu/949/concepts/load-capability-line-categories/>
PREFIX pst:   <http://data.europa.eu/949/concepts/profile-num-semi-trailers/>

# Electrification per country: energy supply systems, contact line and pantograph
# parameters, with a check of which tracks are electrified.

view:electrification
    a sh:NodeShape ;
    atlas:view "electrification" ;
    rdfs:label "Electrification" ;
    rdfs:comment "Energy supply systems, contact lines and pantographs, and which tracks are not electrified, per country." ;
    sh:order 40 ;
    atlas:viewClass "section-of-line", "running-track" ;
    atlas:groupBy "country" ;
    atlas:groupLabel "Country" ;
    atlas:colorBy "contactLineSystem.energySupplySystem" ;
    atlas:checkClass "running-track", "track" ;
    atlas:checkSection "section-of-line" ;
    sh:property [ atlas:facet "contactLineSystem.energySupplySystem" ; sh:order 10 ] ;
    sh:property [ atlas:facet "contactLineSystem.contactLineSystemType" ; sh:order 20 ] ;
    sh:property [ atlas:facet "contactLineSystem.maxTrainCurrent" ; sh:order 30 ] ;
    sh:property [ atlas:facet "contactLineSystem.maximumContactWireHeight" ; sh:order 40 ] ;
    sh:property [ atlas:facet "contactLineSystem.minimumContactWireHeight" ; sh:order 50 ] ;
    sh:property [ atlas:facet "tsiPantographHead" ; sh:order 60 ] ;
    sh:property [ atlas:facet "contactLineSystem.conditionalRegenerativeBrake" ; sh:order 70 ] ;
    sh:property [
        atlas:check "electrification.electrified" ;
        rdfs:label "Electrified" ;
        rdfs:comment "The track has an energy supply system other than “not electrified”. A track without one has no contact line." ;
        atlas:compareTo "contactLineSystem.energySupplySystem" ;
        atlas:notIn ( cls:40 ) ;
        atlas:whenMissing atlas:DoesNotMeet ;
        sh:order 10 ;
    ] .
