PREFIX atlas: <https://rinf-atlas.matdata.eu/ns#>
PREFIX view:  <https://rinf-atlas.matdata.eu/views/>
PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX era:   <http://data.europa.eu/949/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX level: <http://data.europa.eu/949/concepts/ten-t-network-levels/>
PREFIX traffic: <http://data.europa.eu/949/concepts/traffic-types/>
PREFIX cls:   <http://data.europa.eu/949/concepts/contact-line-systems/>
PREFIX etcs:  <http://data.europa.eu/949/concepts/etcs-levels/>
PREFIX lclc:  <http://data.europa.eu/949/concepts/load-capability-line-categories/>
PREFIX pst:   <http://data.europa.eu/949/concepts/profile-num-semi-trailers/>

# Rail freight corridors (Regulation (EU) No 913/2010), as declared in RINF
# (era:freightCorridor on the tracks), with the parameters freight operators plan with.

view:freight-corridors
    a sh:NodeShape ;
    atlas:view "freight-corridors" ;
    rdfs:label "Rail freight corridors" ;
    rdfs:comment "Lines of the rail freight corridors, as declared in RINF, with train length, axle load, loading gauge and the systems a freight train needs." ;
    sh:order 20 ;
    atlas:viewClass "section-of-line", "running-track" ;
    atlas:groupBy "freightCorridor" ;
    atlas:groupLabel "Freight corridor" ;
    atlas:colorBy "freightCorridor" ;
    sh:property [ atlas:facet "freightCorridor" ; sh:order 10 ] ;
    sh:property [ atlas:facet "maxPermittedTrainLength" ; sh:order 20 ] ;
    sh:property [ atlas:facet "trackLoadCapability.loadCapabilityLineCategory" ; sh:order 30 ] ;
    sh:property [ atlas:facet "gaugingProfile" ; sh:order 40 ] ;
    sh:property [ atlas:facet "profileNumberSemiTrailers" ; sh:order 50 ] ;
    sh:property [ atlas:facet "profileNumberSwapBodies" ; sh:order 60 ] ;
    sh:property [ atlas:facet "maximumPermittedSpeed" ; sh:order 70 ] ;
    sh:property [ atlas:facet "contactLineSystem.energySupplySystem" ; sh:order 80 ] ;
    sh:property [ atlas:facet "etcs.etcsLevelType" ; sh:order 90 ] ;
    sh:property [ atlas:facet "protectionLegacySystem" ; sh:order 100 ] ;
    sh:property [ atlas:facet "wheelSetGauge" ; sh:order 110 ] .
