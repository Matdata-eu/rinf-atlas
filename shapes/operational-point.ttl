# Operational Point
# Generated by `atlas generate-shapes` from ERA ontology v3.3.4 and the mirrored RINF data.
# Edit freely: add, remove or reorder sh:property blocks, change labels,
# kinds or paths. Annotations are documented in shapes/atlas.ttl.
# Run `atlas reindex` after editing (no download needed).
PREFIX atlas: <https://rinf-atlas.matdata.eu/ns#>
PREFIX shape: <https://rinf-atlas.matdata.eu/shapes/>
PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX era:   <http://data.europa.eu/949/>
PREFIX gsp:   <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

shape:operational-point
    a sh:NodeShape ;
    atlas:key "operational-point" ;
    rdfs:label "Operational Point" ;
    sh:targetClass era:OperationalPoint ;
    atlas:color "#d62728" ;
    atlas:geometry "point" ;
    atlas:order 10 ;
    atlas:minZoom 0 ;
    atlas:drawOrder 20 ;
    atlas:labelPath rdfs:label ;
    atlas:geometryPath [ sh:alternativePath ( ( era:netReference gsp:hasGeometry gsp:asWKT ) ( gsp:hasGeometry gsp:asWKT ) ) ] ;
    atlas:geometryFrom era:primaryLocation ;
    sh:property [  # RINF 1.1.0.0.1.2, 1618 instances in data
        sh:path era:operatingLanguage ;
        atlas:facet "operatingLanguage" ;
        rdfs:label "Operating language" ;
        atlas:kind "terms" ;
        sh:order 10 ;
    ] ;
    sh:property [  # RINF 1.1.1.4.1, 8465 instances in data
        sh:path era:localRulesOrRestrictions ;
        atlas:facet "localRulesOrRestrictions" ;
        rdfs:label "Existence of rules and restrictions of a strictly local nature" ;
        atlas:kind "boolean" ;
        sh:order 20 ;
    ] ;
    sh:property [  # RINF 1.2.0.0.0.1, 60602 instances in data
        sh:path era:opName ;
        atlas:facet "opName" ;
        rdfs:label "Name of operational point" ;
        atlas:kind "text" ;
        sh:order 30 ;
    ] ;
    sh:property [  # RINF 1.2.0.0.0.2, 60602 instances in data
        sh:path era:uopid ;
        atlas:facet "uopid" ;
        rdfs:label "Unique OP ID" ;
        atlas:kind "text" ;
        sh:order 40 ;
    ] ;
    sh:property [  # RINF 1.2.0.0.0.4, 60602 instances in data
        sh:path era:opType ;
        atlas:facet "opType" ;
        rdfs:label "Type of operational point" ;
        atlas:kind "terms" ;
        sh:order 50 ;
    ] ;
    sh:property [  # RINF 1.2.0.0.0.7, 860 instances in data
        sh:path era:hasSchematicOverviewOPDigitalForm ;
        atlas:facet "hasSchematicOverviewOPDigitalForm" ;
        rdfs:label "Schematic overview of the operational point in digital form" ;
        atlas:kind "boolean" ;
        sh:order 60 ;
    ] ;
    sh:property [  # 36 instances in data
        sh:path ( era:referenceBorderPoint era:borderPointId ) ;
        atlas:facet "referenceBorderPoint.borderPointId" ;
        rdfs:label "Border point identification (reference border point)" ;
        atlas:kind "text" ;
        sh:order 70 ;
    ] .
