# Special area
# Generated by `atlas generate-shapes` from ERA ontology v3.3.4 and the mirrored RINF data.
# Edit freely: add, remove or reorder sh:property blocks, change labels,
# kinds or paths. Annotations are documented in shapes/atlas.ttl.
# Run `atlas reindex` after editing (no download needed).
PREFIX atlas: <https://rinf-atlas.matdata.eu/ns#>
PREFIX shape: <https://rinf-atlas.matdata.eu/shapes/>
PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX era:   <http://data.europa.eu/949/>
PREFIX gsp:   <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

shape:special-area
    a sh:NodeShape ;
    atlas:key "special-area" ;
    rdfs:label "Special area" ;
    sh:targetClass era:SpecialArea ;
    atlas:color "#c49c94" ;
    atlas:geometry "any" ;
    atlas:order 110 ;
    atlas:minZoom 7 ;
    atlas:drawOrder 5 ;
    atlas:labelPath rdfs:label ;
    atlas:geometryPath [ sh:alternativePath ( ( era:netReference gsp:hasGeometry gsp:asWKT ) ( gsp:hasGeometry gsp:asWKT ) ) ] ;
    atlas:geometryFrom [ sh:alternativePath ( era:isPartOf [ sh:inversePath era:hasPart ] ) ] .
