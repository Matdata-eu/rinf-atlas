# Platform edge
# Generated by `atlas generate-shapes` from ERA ontology v3.3.4 and the mirrored RINF data.
# Edit freely: add, remove or reorder sh:property blocks, change labels,
# kinds or paths. Annotations are documented in shapes/atlas.ttl.
# Run `atlas reindex` after editing (no download needed).
PREFIX atlas: <https://rinf-atlas.matdata.eu/ns#>
PREFIX shape: <https://rinf-atlas.matdata.eu/shapes/>
PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX era:   <http://data.europa.eu/949/>
PREFIX gsp:   <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

shape:platform-edge
    a sh:NodeShape ;
    atlas:key "platform-edge" ;
    rdfs:label "Platform edge" ;
    sh:targetClass era:PlatformEdge ;
    atlas:color "#ff7f0e" ;
    atlas:geometry "any" ;
    atlas:order 60 ;
    atlas:minZoom 6 ;
    atlas:labelPath rdfs:label ;
    atlas:geometryPath [ sh:alternativePath ( ( gsp:hasGeometry gsp:asWKT ) ( era:netReference gsp:hasGeometry gsp:asWKT ) ) ] ;
    atlas:geometryFrom [ sh:alternativePath ( era:isPartOf [ sh:inversePath era:hasPart ] ) ] ;
    sh:property [  # RINF 1.1.1.1.2.1, 29830 instances in data
        sh:path era:tenClassification ;
        atlas:facet "tenClassification" ;
        rdfs:label "TEN classification of track" ;
        atlas:kind "terms" ;
        sh:order 10 ;
    ] ;
    sh:property [  # RINF 1.2.1.0.6.2, 54415 instances in data
        sh:path era:platformId ;
        atlas:facet "platformId" ;
        rdfs:label "Identification of platform" ;
        atlas:kind "text" ;
        sh:order 20 ;
    ] ;
    sh:property [  # RINF 1.2.1.0.6.4, 45274 instances in data
        sh:path era:lengthOfPlatform ;
        atlas:facet "lengthOfPlatform" ;
        rdfs:label "Usable length of platform" ;
        atlas:kind "range" ;
        sh:datatype xsd:double ;
        atlas:unit "M" ;
        sh:order 30 ;
    ] ;
    sh:property [  # RINF 1.2.1.0.6.5, 42277 instances in data
        sh:path era:platformHeight ;
        atlas:facet "platformHeight" ;
        rdfs:label "Height of platform" ;
        atlas:kind "terms" ;
        sh:order 40 ;
    ] ;
    sh:property [  # RINF 1.2.1.0.6.6, 28858 instances in data
        sh:path era:assistanceStartingTrain ;
        atlas:facet "assistanceStartingTrain" ;
        rdfs:label "Existence of platform assistance for starting train" ;
        atlas:kind "boolean" ;
        sh:order 50 ;
    ] ;
    sh:property [  # RINF 1.2.1.0.6.7, 20355 instances in data
        sh:path era:areaBoardingAid ;
        atlas:facet "areaBoardingAid" ;
        rdfs:label "Range of use of the platform boarding aid" ;
        atlas:kind "range" ;
        sh:datatype xsd:integer ;
        atlas:unit "MilliM" ;
        sh:order 60 ;
    ] ;
    sh:property [  # RINF 1.2.1.0.6.8, 2870 instances in data
        sh:path era:hasPlatformCurvature ;
        atlas:facet "hasPlatformCurvature" ;
        rdfs:label "Curvature of the platform" ;
        atlas:kind "boolean" ;
        sh:order 70 ;
    ] ;
    sh:property [  # RINF 1.2.1.0.7.1, 160 instances in data
        sh:path era:permissionChargingElectricEnergyTractionStandstill ;
        atlas:facet "permissionChargingElectricEnergyTractionStandstill" ;
        rdfs:label "Permission for charging electric energy storage for traction purposes at standstill" ;
        atlas:kind "boolean" ;
        sh:order 80 ;
    ] .
