# Primary Location
# Generated by `atlas generate-shapes` from ERA ontology v3.3.4 and the mirrored RINF data.
# Edit freely: add, remove or reorder sh:property blocks, change labels,
# kinds or paths. Annotations are documented in shapes/atlas.ttl.
# Run `atlas reindex` after editing (no download needed).
PREFIX atlas: <https://rinf-atlas.matdata.eu/ns#>
PREFIX shape: <https://rinf-atlas.matdata.eu/shapes/>
PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX era:   <http://data.europa.eu/949/>
PREFIX gsp:   <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

shape:primary-location
    a sh:NodeShape ;
    atlas:key "primary-location" ;
    rdfs:label "Primary Location" ;
    sh:targetClass era:PrimaryLocation ;
    atlas:color "#e8a33d" ;
    atlas:geometry "point" ;
    atlas:order 95 ;
    atlas:minZoom 4 ;
    atlas:labelPath rdfs:label ;
    atlas:geometryPath [ sh:alternativePath ( ( gsp:hasGeometry gsp:asWKT ) ( era:netReference gsp:hasGeometry gsp:asWKT ) ) ] ;
    atlas:geometryFrom [ sh:inversePath era:primaryLocation ] ;
    sh:property [  # RINF 1.1.0.0.1.2, 2573 instances in data
        sh:path era:operatingLanguage ;
        atlas:facet "operatingLanguage" ;
        rdfs:label "Operating language" ;
        atlas:kind "terms" ;
        sh:order 10 ;
    ] ;
    sh:property [  # RINF 1.2.0.0.0.3, 7133 instances in data
        sh:path era:primaryLocationCode ;
        atlas:facet "primaryLocationCode" ;
        rdfs:label "Primary location code" ;
        atlas:kind "text" ;
        sh:order 20 ;
    ] ;
    sh:property [  # 3843 instances in data
        sh:path era:containerHandlingFlag ;
        atlas:facet "containerHandlingFlag" ;
        rdfs:label "Container handling flag" ;
        atlas:kind "boolean" ;
        sh:order 30 ;
    ] ;
    sh:property [  # 3850 instances in data
        sh:path era:freightFlag ;
        atlas:facet "freightFlag" ;
        rdfs:label "Freight flag" ;
        atlas:kind "boolean" ;
        sh:order 40 ;
    ] ;
    sh:property [  # 3847 instances in data
        sh:path era:handoverPointFlag ;
        atlas:facet "handoverPointFlag" ;
        rdfs:label "Handover point flag" ;
        atlas:kind "boolean" ;
        sh:order 50 ;
    ] ;
    sh:property [  # 4521 instances in data
        sh:path era:passengerFlag ;
        atlas:facet "passengerFlag" ;
        rdfs:label "Passenger flag" ;
        atlas:kind "boolean" ;
        sh:order 60 ;
    ] ;
    sh:property [  # 7133 instances in data
        sh:path era:primaryLocationName ;
        atlas:facet "primaryLocationName" ;
        rdfs:label "Primary location name" ;
        atlas:kind "text" ;
        sh:order 70 ;
    ] .
