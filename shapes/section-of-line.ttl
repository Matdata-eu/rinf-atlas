# Section Of Line
# Generated by `atlas generate-shapes` from ERA ontology v3.3.4 and the mirrored RINF data.
# Edit freely: add, remove or reorder sh:property blocks, change labels,
# kinds or paths. Annotations are documented in shapes/atlas.ttl.
# Run `atlas reindex` after editing (no download needed).
PREFIX atlas: <https://rinf-atlas.matdata.eu/ns#>
PREFIX shape: <https://rinf-atlas.matdata.eu/shapes/>
PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX era:   <http://data.europa.eu/949/>
PREFIX gsp:   <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

shape:section-of-line
    a sh:NodeShape ;
    atlas:key "section-of-line" ;
    rdfs:label "Section Of Line" ;
    sh:targetClass era:SectionOfLine ;
    atlas:color "#1f77b4" ;
    atlas:geometry "line" ;
    atlas:order 20 ;
    atlas:minZoom 0 ;
    atlas:labelPath rdfs:label ;
    atlas:geometryPath [ sh:alternativePath ( ( gsp:hasGeometry gsp:asWKT ) ( era:netReference gsp:hasGeometry gsp:asWKT ) ) ] ;
    atlas:lineBetween ( era:opStart era:opEnd ) ;
    sh:property [  # RINF 1.1.0.0.0.2, 63747 instances in data
        sh:path ( era:nationalLine era:lineId ) ;
        atlas:facet "nationalLine.lineId" ;
        rdfs:label "Line identifier (national line identification)" ;
        atlas:kind "terms" ;
        sh:order 10 ;
    ] ;
    sh:property [  # RINF 1.1.0.0.0.5, 64464 instances in data
        sh:path era:lengthOfSectionOfLine ;
        atlas:facet "lengthOfSectionOfLine" ;
        rdfs:label "Length of section of line" ;
        atlas:kind "range" ;
        sh:datatype xsd:double ;
        atlas:unit "KiloM" ;
        sh:order 20 ;
    ] ;
    sh:property [  # RINF 1.1.0.0.0.6, 64464 instances in data
        sh:path era:solNature ;
        atlas:facet "solNature" ;
        atlas:colorBy 20 ;
        rdfs:label "Nature of Section of Line" ;
        atlas:kind "terms" ;
        sh:order 30 ;
    ] ;
    sh:property [  # RINF 1.1.0.0.1.1, 1621 instances in data
        sh:path era:existenceOfIndustrialRisk ;
        atlas:facet "existenceOfIndustrialRisk" ;
        rdfs:label "Industrial risks — locations where it is dangerous for the driver to step out" ;
        atlas:kind "boolean" ;
        sh:order 40 ;
    ] ;
    sh:property [  # RINF 1.1.0.0.1.2, 211 instances in data
        sh:path era:operatingLanguage ;
        atlas:facet "operatingLanguage" ;
        rdfs:label "Operating language" ;
        atlas:kind "terms" ;
        sh:order 50 ;
    ] ;
    sh:property [  # RINF 1.1.0.0.1.3, 1621 instances in data
        sh:path era:operationalRegimeType ;
        atlas:facet "operationalRegimeType" ;
        rdfs:label "Operational regime" ;
        atlas:kind "terms" ;
        sh:order 60 ;
    ] ;
    sh:property [  # 98 instances in data
        sh:path ( era:nationalLine era:lrsMethod ) ;
        atlas:facet "nationalLine.lrsMethod" ;
        rdfs:label "Type of line referencing system (national line identification)" ;
        atlas:kind "terms" ;
        sh:order 70 ;
    ] .
