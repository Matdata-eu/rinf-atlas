# Vehicle compatibility rules
#
# One sh:NodeShape with atlas:compatibility true. It targets era:VehicleType:
# each sh:property is one technical characteristic a user can fill in a
# vehicle profile, with
#   sh:path            the property of era:VehicleType (or a sequence path from
#                      it) that holds the characteristic in the ERA ontology;
#                      used for the Turtle import / export of profiles
#   atlas:characteristic  key of the characteristic in profiles and the API
#   atlas:compareTo    infrastructure facet key(s) it is compared with (keys
#                      from the facet shapes, so the facet must be indexed);
#                      several keys pool their values
#   atlas:constraint   the SHACL constraint component the vehicle's value(s)
#                      are plugged into, applied to the infrastructure values:
#       sh:hasValue      the infrastructure has (one of) the vehicle's values
#       sh:in            every infrastructure value is one of the vehicle's
#       sh:minInclusive  every infrastructure value >= the vehicle's value
#       sh:maxInclusive  every infrastructure value <= the vehicle's value
#       sh:minExclusive / sh:maxExclusive  likewise, strict
#   atlas:appliesTo    "track" (default: compared with the running tracks of a
#                      section of line) or "section" (the section itself)
#   atlas:unit         unit of the value the user enters (that of the facet)
#   atlas:whenMissing  what a track without a value means: atlas:Unknown
#                      (default; yellow) or atlas:Incompatible (red)
#   atlas:noneValue    an IRI the user can pick besides the real values, meaning
#                      "the vehicle also runs where the system is absent" (e.g.
#                      not electrified, for bi-mode vehicles): a track without a
#                      value is then compatible
#   atlas:noneFrom     characteristic key of the rule (with atlas:noneValue)
#                      that says whether the system is absent: a track without a
#                      value for this rule fails or passes as above only when it
#                      has no value for that rule either (no contact line), and
#                      is unknown otherwise (contact line without the parameter)
#   atlas:missingReason  shown in the per-track explanation for such a track
#   atlas:termValue    for a numeric rule compared with a facet of concepts:
#                      [ atlas:term <concept> ; atlas:value <number> ], the
#                      number each concept stands for (e.g. the axle load limit
#                      of an EN 15528 line category). The track is compatible
#                      when at least one of its concepts satisfies the
#                      constraint (and, for rules on the same facet, the same
#                      concept satisfies all of them), not compatible when it
#                      only has listed concepts that do not, and unknown when
#                      none of its concepts is listed
#   atlas:pathFactor   the ERA property along sh:path holds the value times this
#                      factor (e.g. 1000 for an axle load entered in t, kg in
#                      ERA); used for the Turtle import / export of profiles
#   atlas:impliedValue [ atlas:facet "key" ; atlas:when <IRI> ; atlas:value <IRI> ]:
#                      a track whose facet "key" has the atlas:when value counts
#                      as having atlas:value for this rule (e.g. era:notApplicable
#                      era:etcs counts as ETCS level N)
#   atlas:withoutValue an IRI the user can pick besides the real values, meaning
#                      "the vehicle does not have this system at all" (e.g. no
#                      ETCS on board), labelled by atlas:withoutLabel. Picking it
#                      replaces it, in the comparison, by the atlas:withoutMatches
#                      values: the track values a vehicle without the system runs
#                      on (e.g. no ETCS, level 0, NTC). A track that only has
#                      other values (it requires the system) is not compatible
#
# Shape-level: atlas:trackClass (repeatable) and atlas:sectionClass name the
# indexed classes (shape keys) that are evaluated.
#
# A characteristic left empty in a profile is not checked. A track without a
# value for the facet makes that characteristic "unknown", unless the rule says
# otherwise with atlas:whenMissing. See docs/DESIGN.md
# for how tracks are aggregated into a status per section of line.
#
# These rules are deliberately simple (one characteristic against one facet).
# Edit them freely; the worker publishes changes within a minute, no reindex.
PREFIX atlas: <https://rinf-atlas.matdata.eu/ns#>
PREFIX shape: <https://rinf-atlas.matdata.eu/shapes/>
PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX era:   <http://data.europa.eu/949/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX lclc:  <http://data.europa.eu/949/concepts/load-capability-line-categories/>
PREFIX mb:    <http://data.europa.eu/949/concepts/magnetic-braking/>
PREFIX ecb:   <http://data.europa.eu/949/concepts/eddy-current-braking/>
PREFIX regb:  <http://data.europa.eu/949/concepts/regenerative-braking/>
PREFIX scl:   <http://data.europa.eu/949/concepts/safe-consist-length/>
PREFIX rsf:   <http://data.europa.eu/949/concepts/rolling-stock-fire/>

shape:vehicle-compatibility
    a sh:NodeShape ;
    atlas:compatibility true ;
    rdfs:label "Vehicle compatibility" ;
    sh:targetClass era:VehicleType ;
    # Every track class: the facets the rules compare are indexed on all of them,
    # and a track without a value takes the value of its section of line when the
    # section class indexes the same facet.
    atlas:trackClass "running-track", "track", "siding" ;
    atlas:sectionClass "section-of-line" ;
    sh:property [
        sh:path era:wheelSetGauge ;
        atlas:characteristic "wheelSetGauge" ;
        rdfs:label "Nominal track gauge" ;
        rdfs:comment "Track gauge(s) the wheelsets run on." ;
        atlas:compareTo "wheelSetGauge" ;
        atlas:constraint sh:hasValue ;
        atlas:group "Gauge and dimensions" ;
        sh:order 10 ;
    ] ;
    sh:property [
        sh:path era:gaugingProfile ;
        atlas:characteristic "gaugingProfile" ;
        rdfs:label "Gauging profile" ;
        rdfs:comment "Gauging profiles of the lines the vehicle fits on (a G1 vehicle: G1, GA, GB, GC …); the track must list one of them." ;
        atlas:compareTo "gaugingProfile" ;
        atlas:constraint sh:hasValue ;
        atlas:group "Gauge and dimensions" ;
        sh:order 20 ;
    ] ;
    sh:property [
        sh:path era:energySupplySystem ;
        atlas:characteristic "energySupplySystem" ;
        rdfs:label "Energy supply system" ;
        rdfs:comment "Voltage and frequency the vehicle can draw power from. Add \"Not electrified\" for a bi-mode vehicle that can also run without a contact line. Leave empty for diesel or battery vehicles." ;
        atlas:compareTo "contactLineSystem.energySupplySystem" ;
        atlas:constraint sh:hasValue ;
        # A track without an energy supply system has no contact line (RINF
        # requires the system on every electrified track; a contact line system of
        # type "Not electrified" has none): an electric vehicle cannot run there.
        atlas:whenMissing atlas:Incompatible ;
        atlas:noneValue <http://data.europa.eu/949/concepts/contact-line-systems/40> ;
        atlas:missingReason "No contact line" ;
        # in a train: what every unit with a raised pantograph accepts
        atlas:combineOver atlas:RaisedPantographs ;
        atlas:group "Energy" ;
        sh:order 30 ;
    ] ;
    sh:property [
        sh:path ( era:configDependentParameter era:vehiclePantographHead ) ;
        atlas:characteristic "pantographHead" ;
        rdfs:label "Pantograph head" ;
        rdfs:comment "Pantograph head(s) fitted; compared with the TSI and other pantograph heads the track accepts." ;
        atlas:compareTo "tsiPantographHead", "otherPantographHead" ;
        atlas:constraint sh:hasValue ;
        atlas:whenMissing atlas:Incompatible ;
        atlas:noneFrom "energySupplySystem" ;
        atlas:missingReason "No contact line" ;
        atlas:combineOver atlas:RaisedPantographs ;
        atlas:group "Energy" ;
        sh:order 40 ;
    ] ;
    sh:property [
        sh:path era:maximumContactWireHeight ;
        atlas:characteristic "maximumContactWireHeight" ;
        rdfs:label "Maximum contact wire height reached" ;
        rdfs:comment "Highest contact wire the pantograph reaches; the track's maximum contact wire height must not be above it." ;
        atlas:compareTo "contactLineSystem.maximumContactWireHeight" ;
        atlas:constraint sh:maxInclusive ;
        atlas:whenMissing atlas:Incompatible ;
        atlas:noneFrom "energySupplySystem" ;
        atlas:missingReason "No contact line" ;
        sh:datatype xsd:double ;
        atlas:unit "M" ;
        atlas:combineOver atlas:RaisedPantographs ;
        atlas:group "Energy" ;
        sh:order 50 ;
    ] ;
    sh:property [
        sh:path ( era:configDependentParameter era:minimumContactWireHeight ) ;
        atlas:characteristic "minimumContactWireHeight" ;
        rdfs:label "Minimum contact wire height reached" ;
        rdfs:comment "Lowest contact wire the pantograph works with; the track's minimum contact wire height must not be below it." ;
        atlas:compareTo "contactLineSystem.minimumContactWireHeight" ;
        atlas:constraint sh:minInclusive ;
        atlas:whenMissing atlas:Incompatible ;
        atlas:noneFrom "energySupplySystem" ;
        atlas:missingReason "No contact line" ;
        sh:datatype xsd:double ;
        atlas:unit "M" ;
        atlas:combineOver atlas:RaisedPantographs ;
        atlas:group "Energy" ;
        sh:order 60 ;
    ] ;
    sh:property [
        sh:path ( era:configDependentParameter era:catenaryMaxRatedCurrent ) ;
        atlas:characteristic "maxTrainCurrent" ;
        rdfs:label "Maximum current drawn from the contact line" ;
        rdfs:comment "Highest current the vehicle (or train) draws from the contact line; the track's maximum train current must not be below it." ;
        atlas:compareTo "contactLineSystem.maxTrainCurrent" ;
        atlas:constraint sh:minInclusive ;
        atlas:whenMissing atlas:Incompatible ;
        atlas:noneFrom "energySupplySystem" ;
        atlas:missingReason "No contact line" ;
        sh:datatype xsd:integer ;
        atlas:unit "A" ;
        # in a train: the sum of the units with a raised pantograph
        atlas:combineOver atlas:RaisedPantographs ;
        atlas:combineBy atlas:Sum ;
        atlas:group "Energy" ;
        sh:order 65 ;
    ] ;
    sh:property [
        sh:path era:etcsEquipmentOnBoardLevel ;
        atlas:characteristic "etcsLevel" ;
        rdfs:label "ETCS level on board" ;
        rdfs:comment "Every ETCS level the on-board equipment supports; the track must have one of them. Pick \"No ETCS installed\" for a vehicle without ETCS: a track that requires ETCS (only level 1, 2 or 3) is then not compatible." ;
        atlas:compareTo "etcs.etcsLevelType" ;
        atlas:constraint sh:hasValue ;
        # ERA SKOS etcs-levels: 10 = N (no ETCS; dropped from the current
        # scheme but still in RINF data), 50 = level 0, 60 = NTC, 20 / 30 / 40
        # = level 1 / 2 / 3. A vehicle without ETCS runs on the first three.
        # A track that declares ETCS not applicable (era:notApplicable era:etcs)
        # has no ETCS: it counts as level N.
        atlas:impliedValue [
            atlas:facet "notApplicable" ;
            atlas:when era:etcs ;
            atlas:value <http://data.europa.eu/949/concepts/etcs-levels/10> ;
        ] ;
        atlas:withoutValue <http://data.europa.eu/949/concepts/etcs-levels/10> ;
        atlas:withoutLabel "No ETCS installed" ;
        atlas:withoutMatches <http://data.europa.eu/949/concepts/etcs-levels/10>,
            <http://data.europa.eu/949/concepts/etcs-levels/50>,
            <http://data.europa.eu/949/concepts/etcs-levels/60> ;
        atlas:combineOver atlas:LeadingCab ;
        atlas:group "Signalling" ;
        sh:order 70 ;
    ] ;
    sh:property [
        sh:path era:protectionLegacySystem ;
        atlas:characteristic "protectionLegacySystem" ;
        rdfs:label "Class B train protection" ;
        rdfs:comment "Legacy (class B) train protection systems fitted; the track must have one of them." ;
        atlas:compareTo "protectionLegacySystem" ;
        atlas:constraint sh:hasValue ;
        atlas:combineOver atlas:LeadingCab ;
        atlas:group "Signalling" ;
        sh:order 80 ;
    ] ;
    sh:property [
        sh:path era:trainDetectionSystemType ;
        atlas:characteristic "trainDetectionSystemType" ;
        rdfs:label "Train detection systems" ;
        rdfs:comment "Train detection systems the vehicle is compatible with; every system on the track must be one of them." ;
        atlas:compareTo "trainDetectionSystem.trainDetectionSystemType" ;
        atlas:constraint sh:in ;
        atlas:group "Signalling" ;
        sh:order 90 ;
    ] ;
    sh:property [
        sh:path era:compatibleWithLineCategory ;
        atlas:characteristic "lineCategory" ;
        rdfs:label "Load capability line categories" ;
        rdfs:comment "EN 15528 line categories the vehicle may run on (a C2 vehicle: C2, C3, C4, D2 …); the track must have one of them." ;
        atlas:compareTo "trackLoadCapability.loadCapabilityLineCategory" ;
        atlas:constraint sh:hasValue ;
        # with a maximum speed: only the categories whose load capability speed is at least
        # that speed (a category without a speed counts at any speed)
        atlas:recordFilter [
            atlas:facet "trackLoadCapability" ;
            atlas:field "category" ;
            atlas:selectBy [ atlas:name "speed" ; atlas:characteristic "maxSpeed" ] ;
        ] ;
        atlas:group "Load" ;
        sh:order 100 ;
    ] ;
    # EN 15528 line categories (ERA SKOS load-capability-line-categories) with
    # their limits: maximum axle load (t) and mass per metre (t/m). A, B1 … E5;
    # D4xL as D4. The UK route availability (RA) and HS17 categories are not
    # listed, so a track with only those is unknown. The speed of the load
    # capability counts when the maximum speed is filled in (atlas:recordFilter).
    sh:property [
        sh:path era:staticAxleLoadNormalPayload ;
        atlas:characteristic "axleLoad" ;
        rdfs:label "Axle load" ;
        rdfs:comment "Highest static axle load of the vehicle, loaded (t); compared with the axle load limit of the EN 15528 line categories of the track." ;
        atlas:compareTo "trackLoadCapability.loadCapabilityLineCategory" ;
        atlas:constraint sh:minInclusive ;
        atlas:termValue
            [ atlas:term lclc:10 ; atlas:value 16.0 ] ,
            [ atlas:term lclc:20 ; atlas:value 18.0 ] ,
            [ atlas:term lclc:30 ; atlas:value 18.0 ] ,
            [ atlas:term lclc:40 ; atlas:value 20.0 ] ,
            [ atlas:term lclc:50 ; atlas:value 20.0 ] ,
            [ atlas:term lclc:60 ; atlas:value 20.0 ] ,
            [ atlas:term lclc:70 ; atlas:value 22.5 ] ,
            [ atlas:term lclc:80 ; atlas:value 22.5 ] ,
            [ atlas:term lclc:90 ; atlas:value 22.5 ] ,
            [ atlas:term lclc:100 ; atlas:value 22.5 ] ,
            [ atlas:term lclc:110 ; atlas:value 25.0 ] ,
            [ atlas:term lclc:120 ; atlas:value 25.0 ] ;
        sh:datatype xsd:double ;
        atlas:unit "TONNE" ;
        # ERA gives the static axle load in kg
        atlas:pathFactor 1000 ;
        # with a maximum speed: only the categories whose load capability speed is at least
        # that speed (a category without a speed counts at any speed)
        atlas:recordFilter [
            atlas:facet "trackLoadCapability" ;
            atlas:field "category" ;
            atlas:selectBy [ atlas:name "speed" ; atlas:characteristic "maxSpeed" ] ;
        ] ;
        atlas:group "Load" ;
        sh:order 102 ;
    ] ;
    sh:property [
        # ERA has no vehicle type property for the mass per metre
        sh:path atlas:massPerMetre ;
        atlas:characteristic "massPerMetre" ;
        rdfs:label "Mass per metre" ;
        rdfs:comment "Mass per metre of length of the vehicle, loaded (t/m); compared with the mass per metre limit of the EN 15528 line categories of the track." ;
        atlas:compareTo "trackLoadCapability.loadCapabilityLineCategory" ;
        atlas:constraint sh:minInclusive ;
        atlas:termValue
            [ atlas:term lclc:10 ; atlas:value 5.0 ] ,
            [ atlas:term lclc:20 ; atlas:value 5.0 ] ,
            [ atlas:term lclc:30 ; atlas:value 6.4 ] ,
            [ atlas:term lclc:40 ; atlas:value 6.4 ] ,
            [ atlas:term lclc:50 ; atlas:value 7.2 ] ,
            [ atlas:term lclc:60 ; atlas:value 8.0 ] ,
            [ atlas:term lclc:70 ; atlas:value 6.4 ] ,
            [ atlas:term lclc:80 ; atlas:value 7.2 ] ,
            [ atlas:term lclc:90 ; atlas:value 8.0 ] ,
            [ atlas:term lclc:100 ; atlas:value 8.0 ] ,
            [ atlas:term lclc:110 ; atlas:value 8.0 ] ,
            [ atlas:term lclc:120 ; atlas:value 8.8 ] ;
        sh:datatype xsd:double ;
        atlas:unit "TONNE-PER-M" ;
        # with a maximum speed: only the categories whose load capability speed is at least
        # that speed (a category without a speed counts at any speed)
        atlas:recordFilter [
            atlas:facet "trackLoadCapability" ;
            atlas:field "category" ;
            atlas:selectBy [ atlas:name "speed" ; atlas:characteristic "maxSpeed" ] ;
        ] ;
        atlas:group "Load" ;
        sh:order 104 ;
    ] ;
    sh:property [
        sh:path era:lengthOfVehicle ;
        atlas:characteristic "trainLength" ;
        rdfs:label "Train length" ;
        rdfs:comment "Length of the vehicle or fixed formation; the track's maximum permitted train length must not be below it." ;
        atlas:compareTo "maxPermittedTrainLength" ;
        atlas:constraint sh:minInclusive ;
        sh:datatype xsd:double ;
        atlas:unit "M" ;
        atlas:combineBy atlas:Sum ;
        atlas:group "Gauge and dimensions" ;
        sh:order 110 ;
    ] ;
    sh:property [
        sh:path era:minWheelDiameter ;
        atlas:characteristic "minWheelDiameter" ;
        rdfs:label "Minimum wheel diameter" ;
        rdfs:comment "Smallest wheel diameter in service; the track's minimum permitted wheel diameter (fixed obtuse crossings) must not be above it." ;
        atlas:compareTo "minimumWheelDiameter" ;
        atlas:constraint sh:maxInclusive ;
        sh:datatype xsd:integer ;
        atlas:unit "MilliM" ;
        atlas:group "Gauge and dimensions" ;
        sh:order 120 ;
    ] ;
    # ---- speed and braking ----
    sh:property [
        sh:path ( era:vehicleTypeMaximumSpeedAndCantDeficiency era:vehicleTypeMaximumSpeed ) ;
        atlas:characteristic "maxSpeed" ;
        rdfs:label "Maximum speed" ;
        rdfs:comment "Highest speed of the vehicle or train. Not checked on its own: the raised pantograph, load capability and braking checks use it." ;
        atlas:input true ;
        sh:datatype xsd:integer ;
        atlas:unit "KiloM-PER-HR" ;
        atlas:group "Speed and braking" ;
        sh:order 200 ;
    ] ;
    sh:property [
        sh:path era:maximumAverageDeceleration ;
        atlas:characteristic "brakingDeceleration" ;
        rdfs:label "Mean braking deceleration" ;
        rdfs:comment "Mean deceleration of the train in a full service brake application (m/s²). The braking distance from the line speed (or the train's maximum speed, if lower) must not exceed the track's maximum braking distance." ;
        atlas:constraint atlas:brakingDistance ;
        atlas:compareTo "maximumBrakingDistance" ;
        atlas:speedFacet "maximumPermittedSpeed" ;
        atlas:speedFrom "maxSpeed" ;
        # the IM publishes more braking requirements: the result is unknown, not compatible
        atlas:caveatFacet "hasAdditionalBrakingInformation" ;
        # braking is a property of the whole train: entered for the train, not per vehicle
        atlas:combineOver atlas:Train ;
        sh:datatype xsd:double ;
        atlas:unit "M-PER-SEC2" ;
        atlas:group "Speed and braking" ;
        sh:order 210 ;
    ] ;
    sh:property [
        # ERA has no vehicle type property for it
        sh:path atlas:maximumDeceleration ;
        atlas:characteristic "maxDeceleration" ;
        rdfs:label "Maximum deceleration" ;
        rdfs:comment "Highest deceleration of the train when braking (m/s²); the track's maximum train deceleration must not be below it." ;
        atlas:compareTo "maximumTrainDeceleration" ;
        atlas:constraint sh:minInclusive ;
        atlas:combineOver atlas:Train ;
        sh:datatype xsd:double ;
        atlas:unit "M-PER-SEC2" ;
        atlas:group "Speed and braking" ;
        sh:order 220 ;
    ] ;
    sh:property [
        sh:path ( era:configDependentParameter era:numberOfPantographsInContactWithOCL ) ;
        atlas:characteristic "raisedPantographs" ;
        rdfs:label "Raised pantographs" ;
        rdfs:comment "Number of pantographs in contact with the contact line. The track's requirement for its speed (the row for the lowest speed at least the maximum speed) must allow that many, at least the spacing between them." ;
        atlas:constraint atlas:record ;
        atlas:compareTo "trackRaisedPantographsDistanceAndSpeed" ;
        atlas:recordField [ atlas:name "number" ; atlas:constraint sh:minInclusive ] ,
            [ atlas:name "distance" ; atlas:constraint sh:maxInclusive ; atlas:characteristic "pantographSpacing" ] ;
        atlas:selectBy [ atlas:name "speed" ; atlas:characteristic "maxSpeed" ] ;
        # in a train: the units with a raised pantograph, one each unless filled in
        atlas:combineOver atlas:RaisedPantographs ;
        atlas:combineBy atlas:Sum ;
        atlas:vehicleDefault 1 ;
        sh:datatype xsd:integer ;
        atlas:group "Energy" ;
        sh:order 66 ;
    ] ;
    sh:property [
        sh:path ( era:configDependentParameter era:shortestDistanceBetweenPantographsInContactWithOCL ) ;
        atlas:characteristic "pantographSpacing" ;
        rdfs:label "Shortest distance between raised pantographs" ;
        rdfs:comment "With two raised pantographs or more: the shortest distance between them (m). Read by the raised pantographs check." ;
        atlas:input true ;
        # in a train: also the distance between the units with a raised pantograph (their centres)
        atlas:combineOver atlas:RaisedPantographs ;
        atlas:combineBy atlas:PantographSpacing ;
        atlas:lengthFrom "trainLength" ;
        sh:datatype xsd:double ;
        atlas:unit "M" ;
        atlas:group "Energy" ;
        sh:order 67 ;
    ] ;

    # ---- equipment the track may require ----
    sh:property [
        sh:path era:hasTrainIntegrityConfirmation ;
        atlas:characteristic "trainIntegrity" ;
        rdfs:label "Train integrity confirmed on board" ;
        rdfs:comment "Whether the train confirms its integrity on board (not the driver). A track that requires it is not compatible with a train without it." ;
        atlas:constraint atlas:requires ;
        atlas:compareTo "etcs.trainIntegrityOnBoardRequired" ;
        atlas:combineOver atlas:LeadingCab ;
        atlas:group "Equipment the track may require" ;
        sh:order 300 ;
    ] ;
    sh:property [
        # ERA has no vehicle type property for it
        sh:path atlas:safeConsistLength ;
        atlas:characteristic "safeConsistLength" ;
        rdfs:label "Safe consist length information on board" ;
        rdfs:comment "Whether the on-board equipment gives safe consist length information, and at which safety integrity level." ;
        atlas:compareTo "safeConsistLengthInformationNecessary" ;
        atlas:constraint sh:in ;
        atlas:option [ atlas:value atlas:SafeConsistLengthNone ; rdfs:label "Not available" ; sh:order 1 ;
                atlas:matches scl:00 ] ,
            [ atlas:value atlas:SafeConsistLengthSil2 ; rdfs:label "SIL 2" ; sh:order 2 ;
                atlas:matches scl:00, scl:02 ] ,
            [ atlas:value atlas:SafeConsistLengthSil4 ; rdfs:label "SIL 4" ; sh:order 3 ;
                atlas:matches scl:00, scl:02, scl:04 ] ;
        atlas:combineOver atlas:LeadingCab ;
        atlas:group "Equipment the track may require" ;
        sh:order 310 ;
    ] ;
    sh:property [
        # ERA has no vehicle type property for it
        sh:path atlas:currentLimitation ;
        atlas:characteristic "currentLimitation" ;
        rdfs:label "Current or power limitation on board" ;
        rdfs:comment "Whether the vehicle limits the current or power it draws. A track that requires it is not compatible with a vehicle without it." ;
        atlas:constraint atlas:requires ;
        atlas:compareTo "contactLineSystem.currentLimitationRequired" ;
        atlas:combineOver atlas:RaisedPantographs ;
        atlas:group "Equipment the track may require" ;
        sh:order 320 ;
    ] ;
    sh:property [
        # ERA has no vehicle type property for it
        sh:path atlas:steadyRedTailLights ;
        atlas:characteristic "redTailLights" ;
        rdfs:label "Steady red tail lights" ;
        rdfs:comment "Whether the end of the train shows steady red lights. In a train: the last vehicle." ;
        atlas:constraint atlas:requires ;
        atlas:compareTo "redLightsRequired" ;
        atlas:impliedValue [ atlas:facet "notApplicable" ; atlas:when era:redLightsRequired ; atlas:value false ] ;
        atlas:combineOver atlas:TailVehicle ;
        atlas:group "Equipment the track may require" ;
        sh:order 330 ;
    ] ;
    sh:property [
        # ERA has no vehicle type property for it (it has the noise levels)
        sh:path atlas:quietVehicle ;
        atlas:characteristic "quiet" ;
        rdfs:label "Quiet vehicle (TSI NOI)" ;
        rdfs:comment "Whether the vehicle complies with the noise limits for quieter routes (TSI NOI). A train is quiet only when every vehicle is." ;
        atlas:constraint atlas:requires ;
        atlas:compareTo "isQuietRoute" ;
        atlas:group "Equipment the track may require" ;
        sh:order 340 ;
    ] ;
    sh:property [
        sh:path era:fireSafetyCategory ;
        atlas:characteristic "fireCategory" ;
        rdfs:label "Fire safety category" ;
        rdfs:comment "Fire safety category of passenger rolling stock (TSI SRT), compared with the category the track's tunnels require. A track without a tunnel is compatible." ;
        atlas:compareTo "rollingStockFireCategory" ;
        atlas:linkedClass "tunnel" ;
        atlas:constraint sh:in ;
        atlas:impliedValue [ atlas:facet "notApplicable" ; atlas:when era:rollingStockFireCategory ; atlas:value rsf:30 ] ;
        atlas:option [ atlas:value rsf:eratv\/20 ; rdfs:label "Category B" ; sh:order 1 ;
                atlas:matches rsf:10, rsf:20, rsf:30 ] ,
            [ atlas:value rsf:eratv\/10 ; rdfs:label "Category A" ; sh:order 2 ;
                atlas:matches rsf:10, rsf:30 ] ,
            [ atlas:value <http://data.europa.eu/949/concepts/rolling-stock-fire/eratv/no-category-acceptable-in-unnels-shorter-then-1km> ;
                rdfs:label "No category" ; sh:order 3 ; atlas:matches rsf:30 ] ;
        atlas:group "Equipment the track may require" ;
        sh:order 350 ;
    ] ;

    # ---- brakes ----
    # ERA SKOS magnetic-braking: 10 allowed, 20 allowed under conditions, 30 allowed under
    # conditions only for the emergency brake, 40 allowed only for the emergency brake,
    # 50 not allowed. eddy-current-braking and regenerative-braking: 10 allowed, 20 under
    # conditions, 30 only for the emergency brake, 40 under conditions only for the
    # emergency brake, 50 not allowed. "Under conditions" makes the result unknown.
    sh:property [
        sh:path era:hasMagneticBrake ;
        atlas:characteristic "magneticBrake" ;
        rdfs:label "Magnetic track brake" ;
        rdfs:comment "How the vehicle uses a magnetic track brake, compared with its use the track allows." ;
        atlas:compareTo "magneticBraking" ;
        atlas:constraint sh:in ;
        atlas:option [ atlas:value atlas:BrakeNotFitted ; rdfs:label "Not fitted" ; sh:order 1 ;
                atlas:anyTrack true ; atlas:pathValue false ] ,
            [ atlas:value atlas:BrakeEmergencyOnly ; rdfs:label "Emergency brake only" ; sh:order 2 ;
                atlas:matches mb:10, mb:40 ; atlas:maybe mb:20, mb:30 ; atlas:pathValue true ] ,
            [ atlas:value atlas:BrakeService ; rdfs:label "Service and emergency brake" ; sh:order 3 ;
                atlas:matches mb:10 ; atlas:maybe mb:20 ; atlas:pathValue true ] ;
        atlas:group "Brakes" ;
        sh:order 400 ;
    ] ;
    sh:property [
        sh:path era:hasEddyCurrentBrake ;
        atlas:characteristic "eddyCurrentBrake" ;
        rdfs:label "Eddy current brake" ;
        rdfs:comment "How the vehicle uses an eddy current brake, compared with its use the track allows." ;
        atlas:compareTo "eddyCurrentBraking" ;
        atlas:constraint sh:in ;
        atlas:option [ atlas:value atlas:BrakeNotFitted ; rdfs:label "Not fitted" ; sh:order 1 ;
                atlas:anyTrack true ; atlas:pathValue false ] ,
            [ atlas:value atlas:BrakeEmergencyOnly ; rdfs:label "Emergency brake only" ; sh:order 2 ;
                atlas:matches ecb:10, ecb:30 ; atlas:maybe ecb:20, ecb:40 ; atlas:pathValue true ] ,
            [ atlas:value atlas:BrakeService ; rdfs:label "Service and emergency brake" ; sh:order 3 ;
                atlas:matches ecb:10 ; atlas:maybe ecb:20 ; atlas:pathValue true ] ;
        atlas:group "Brakes" ;
        sh:order 410 ;
    ] ;
    sh:property [
        sh:path era:hasRegenerativeBrake ;
        atlas:characteristic "regenerativeBrake" ;
        rdfs:label "Regenerative brake" ;
        rdfs:comment "Whether the vehicle feeds braking energy back into the contact line, compared with the permission of the track's contact line system." ;
        atlas:compareTo "contactLineSystem.conditionalRegenerativeBrake" ;
        atlas:constraint sh:in ;
        atlas:noneFrom "energySupplySystem" ;
        atlas:option [ atlas:value atlas:BrakeNotFitted ; rdfs:label "Not used" ; sh:order 1 ;
                atlas:anyTrack true ; atlas:pathValue false ] ,
            [ atlas:value atlas:BrakeService ; rdfs:label "Used" ; sh:order 2 ;
                atlas:matches regb:10 ; atlas:maybe regb:20 ; atlas:pathValue true ] ;
        atlas:combineOver atlas:RaisedPantographs ;
        atlas:group "Brakes" ;
        sh:order 420 ;
    ] .
