# Kilometric Post
# Generated by `atlas generate-shapes` from ERA ontology v3.3.4 and the mirrored RINF data.
# Edit freely: add, remove or reorder sh:property blocks, change labels,
# kinds or paths. Annotations are documented in shapes/atlas.ttl.
# Run `atlas reindex` after editing (no download needed).
PREFIX atlas: <https://rinf-atlas.matdata.eu/ns#>
PREFIX shape: <https://rinf-atlas.matdata.eu/shapes/>
PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX era:   <http://data.europa.eu/949/>
PREFIX gsp:   <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

shape:kilometric-post
    a sh:NodeShape ;
    atlas:key "kilometric-post" ;
    rdfs:label "Kilometric Post" ;
    sh:targetClass era:KilometricPost ;
    atlas:color "#7f7f7f" ;
    atlas:geometry "point" ;
    atlas:order 90 ;
    atlas:minZoom 12 ;
    atlas:drawOrder 40 ;
    atlas:labelPath rdfs:label ;
    atlas:geometryPath [ sh:alternativePath ( ( era:netReference gsp:hasGeometry gsp:asWKT ) ( gsp:hasGeometry gsp:asWKT ) ) ] ;
    sh:property [  # RINF 1.2.0.0.0.6, 57627 instances in data
        sh:path era:kilometer ;
        atlas:facet "kilometer" ;
        rdfs:label "Kilometer number" ;
        atlas:kind "range" ;
        sh:datatype xsd:double ;
        atlas:unit "KiloM" ;
        sh:order 10 ;
    ] ;
    sh:property [  # 10717 instances in data
        sh:path era:kmPostName ;
        atlas:facet "kmPostName" ;
        rdfs:label "Kilometric post name" ;
        atlas:kind "text" ;
        sh:order 20 ;
    ] ;
    sh:property [  # 2644 instances in data
        sh:path era:measuredDistance ;
        atlas:facet "measuredDistance" ;
        rdfs:label "Measured distance" ;
        atlas:kind "range" ;
        sh:datatype xsd:double ;
        atlas:unit "M" ;
        sh:order 30 ;
    ] .
