PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

shape:track
    a sh:NodeShape ;
    atlas:key "track" ;
    rdfs:label "Track" ;
    sh:targetClass era:Track ;
    atlas:color "#2ca02c" ;
    atlas:geometry "line" ;
    atlas:order 45 ;
    atlas:minZoom 10 ;
    atlas:drawOrder 22 ;
