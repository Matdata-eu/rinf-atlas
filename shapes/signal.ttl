# Signal
# Generated by `atlas generate-shapes` from ERA ontology v3.3.4 and the mirrored RINF data.
# Edit freely: add, remove or reorder sh:property blocks, change labels,
# kinds or paths. Annotations are documented in shapes/atlas.ttl.
# Run `atlas reindex` after editing (no download needed).
PREFIX atlas: <https://rinf-atlas.matdata.eu/ns#>
PREFIX shape: <https://rinf-atlas.matdata.eu/shapes/>
PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX era:   <http://data.europa.eu/949/>
PREFIX gsp:   <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

shape:signal
    a sh:NodeShape ;
    atlas:key "signal" ;
    rdfs:label "Signal" ;
    sh:targetClass era:Signal ;
    atlas:color "#bcbd22" ;
    atlas:geometry "point" ;
    atlas:order 75 ;
    atlas:minZoom 11 ;
    atlas:labelPath rdfs:label ;
    atlas:geometryPath [ sh:alternativePath ( ( gsp:hasGeometry gsp:asWKT ) ( era:netReference gsp:hasGeometry gsp:asWKT ) ) ] ;
    atlas:geometryFrom [ sh:alternativePath ( era:isPartOf [ sh:inversePath era:hasPart ] ) ] ;
    sh:property [  # RINF 1.1.1.3.14.1, 2190 instances in data
        sh:path era:signalId ;
        atlas:facet "signalId" ;
        rdfs:label "Name of signal" ;
        atlas:kind "text" ;
        sh:order 10 ;
    ] ;
    sh:property [  # RINF 1.1.1.3.14.2, 7481 instances in data
        sh:path era:signalType ;
        atlas:facet "signalType" ;
        rdfs:label "Type of signal" ;
        atlas:kind "terms" ;
        sh:order 20 ;
    ] ;
    sh:property [  # RINF 1.1.1.3.14.3, 2190 instances in data
        sh:path era:signalOrientation ;
        atlas:facet "signalOrientation" ;
        rdfs:label "Signal orientation" ;
        atlas:kind "terms" ;
        sh:order 30 ;
    ] ;
    sh:property [  # RINF 1.1.1.3.14.4, 2190 instances in data
        sh:path era:relativeDistanceDangerPoint ;
        atlas:facet "relativeDistanceDangerPoint" ;
        rdfs:label "Relative distance of the danger point" ;
        atlas:kind "range" ;
        sh:datatype xsd:integer ;
        atlas:unit "M" ;
        sh:order 40 ;
    ] .
