# Full RINF: export profile generated by `atlas generate-export-profile` from ERA's RINF SHACL shapes (v3.3.4).
# One shape per infrastructure class; every sh:property is a column of a tabular export.
# Nested shapes (sh:node) flatten a component (contact line system, net reference...) into
# sub-columns. Edit freely, or copy a shape into a new profile with its own atlas:ExportProfile.
# Annotations are documented in shapes/atlas.ttl.
PREFIX atlas: <https://rinf-atlas.matdata.eu/ns#>
PREFIX xp:    <https://rinf-atlas.matdata.eu/export/>
PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX era:   <http://data.europa.eu/949/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

xp:full
    a atlas:ExportProfile ;
    atlas:key "full" ;
    rdfs:label "Full RINF" ;
    rdfs:comment "Every RINF parameter allowed by ERA's SHACL shapes v3.3.4, per class, with the RINF parameter numbers. Generated; edit as you like." ;
    atlas:order 20 .
xp:full-Geometry
    a sh:NodeShape ;
    sh:targetClass <http://www.opengis.net/ont/geosparql#Geometry> ;
    rdfs:label "Geometry" ;
    sh:property [
        sh:path <http://www.opengis.net/ont/geosparql#asWKT> ;
        rdfs:label "WKT" ;
        sh:datatype <http://www.opengis.net/ont/geosparql#wktLiteral> ;
        sh:order 10 ;
    ] .

xp:full-Activity
    a sh:NodeShape ;
    sh:targetClass era:Activity ;
    rdfs:label "Activity" ;
    sh:property [
        sh:path era:revokedCode ;
        rdfs:label "Revoked code" ;
        sh:datatype xsd:string ;
        sh:order 10 ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/creator> ;
        rdfs:label "Creator" ;
        sh:order 20 ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/type> ;
        rdfs:label "Type" ;
        sh:order 30 ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/valid> ;
        rdfs:label "Valid" ;
        sh:datatype xsd:dateTimeStamp ;
        sh:order 40 ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/2000/01/rdf-schema#label> ;
        rdfs:label "Label" ;
        sh:datatype <http://www.w3.org/1999/02/22-rdf-syntax-ns#langString> ;
        sh:order 50 ;
    ] .

xp:full-Body
    a sh:NodeShape ;
    sh:targetClass era:Body ;
    rdfs:label "Body" ;
    sh:property [
        sh:path era:organisationCode ;
        rdfs:label "Organisation code" ;
        era:rinfIndex "1.2.1.0.5.1" ;
        sh:datatype xsd:string ;
        sh:order 10 ;
    ] ;
    sh:property [
        sh:path era:alternativeCode ;
        rdfs:label "Alternative Code" ;
        sh:datatype xsd:string ;
        sh:order 20 ;
    ] ;
    sh:property [
        sh:path era:changeActivity ;
        rdfs:label "Change activity" ;
        sh:node xp:full-Activity ;
        sh:order 30 ;
    ] ;
    sh:property [
        sh:path era:role ;
        rdfs:label "Role" ;
        sh:order 40 ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/creator> ;
        rdfs:label "Creator" ;
        sh:order 50 ;
    ] .

xp:full-OrganisationRole
    a sh:NodeShape ;
    sh:targetClass era:OrganisationRole ;
    rdfs:label "Organisation Role" ;
    sh:property [
        sh:path era:hasOrganisationRole ;
        rdfs:label "Has organisation role" ;
        sh:order 10 ;
    ] ;
    sh:property [
        sh:path era:roleOf ;
        rdfs:label "Role of" ;
        sh:node xp:full-Body ;
        sh:order 20 ;
    ] .

xp:full-Instant
    a sh:NodeShape ;
    sh:targetClass <http://www.w3.org/2006/time#Instant> ;
    rdfs:label "Time instant" ;
    sh:property [
        sh:path <http://www.w3.org/2006/time#inDateTime> ;
        rdfs:label "In date time" ;
        sh:order 10 ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/2006/time#inTemporalPosition> ;
        rdfs:label "In temporal position" ;
        sh:order 20 ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/2006/time#inTimePosition> ;
        rdfs:label "In time position" ;
        sh:order 30 ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/2006/time#inXSDDate> ;
        rdfs:label "In xsd date" ;
        sh:datatype xsd:date ;
        sh:order 40 ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/2006/time#inXSDDateTimeStamp> ;
        rdfs:label "In xsd date time stamp" ;
        sh:datatype xsd:dateTimeStamp ;
        sh:order 50 ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/2006/time#inXSDgYear> ;
        rdfs:label "In xs dg year" ;
        sh:datatype xsd:gYear ;
        sh:order 60 ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/2006/time#inXSDgYearMonth> ;
        rdfs:label "In xs dg year month" ;
        sh:datatype xsd:gYearMonth ;
        sh:order 70 ;
    ] .

xp:full-ParameterApplicability
    a sh:NodeShape ;
    sh:targetClass era:ParameterApplicability ;
    rdfs:label "Parameter applicability" ;
    sh:property [
        sh:path era:ofParameter ;
        rdfs:label "Of parameter" ;
        sh:order 10 ;
    ] ;
    sh:property [
        sh:path era:parameterValue ;
        rdfs:label "Parameter value" ;
        sh:order 20 ;
    ] ;
    sh:property [
        sh:path era:parameterValueType ;
        rdfs:label "Parameter value type" ;
        sh:order 30 ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/2006/time#hasBeginning> ;
        rdfs:label "Has beginning" ;
        sh:node xp:full-Instant ;
        sh:order 40 ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/2006/time#hasEnd> ;
        rdfs:label "Has end" ;
        sh:node xp:full-Instant ;
        sh:order 50 ;
    ] .

xp:full-Bridge
    a sh:NodeShape ;
    atlas:profile xp:full ;
    sh:targetClass era:Bridge ;
    rdfs:label "Bridge" ;
    sh:property [
        sh:path <http://www.opengis.net/ont/geosparql#hasGeometry> ;
        rdfs:label "Geometry" ;
        era:rinfIndex "1.2.0.0.0.5" ;
        sh:node xp:full-Geometry ;
        sh:order 10 ;
    ] ;
    sh:property [
        sh:path era:operatingLanguage ;
        rdfs:label "Operating language" ;
        era:rinfIndex "1.2.0.0.0.8" ;
        sh:order 20 ;
    ] ;
    sh:property [
        sh:path era:belongsTo ;
        rdfs:label "Belongs to" ;
        sh:order 30 ;
    ] ;
    sh:property [
        sh:path era:canonicalURI ;
        rdfs:label "Canonical URI" ;
        sh:order 40 ;
    ] ;
    sh:property [
        sh:path era:exemptSpecialVehiclesFromATO ;
        rdfs:label "Exempt special vehicles from ATO" ;
        sh:datatype xsd:boolean ;
        sh:order 50 ;
    ] ;
    sh:property [
        sh:path era:exemptSpecialVehiclesFromETCS ;
        rdfs:label "Exempt special vehicles from ETCS" ;
        sh:datatype xsd:boolean ;
        sh:order 60 ;
    ] ;
    sh:property [
        sh:path era:exemptSpecialVehiclesFromRMR ;
        rdfs:label "Exempt special vehicles from RMR" ;
        sh:datatype xsd:boolean ;
        sh:order 70 ;
    ] ;
    sh:property [
        sh:path era:existBridgeWindRestriction ;
        rdfs:label "Existence of bridge wind restriction" ;
        sh:datatype xsd:boolean ;
        sh:order 80 ;
    ] ;
    sh:property [
        sh:path era:existOpeningHoursLimitation ;
        rdfs:label "Existence of opening hours limitation" ;
        sh:datatype xsd:boolean ;
        sh:order 90 ;
    ] ;
    sh:property [
        sh:path era:hasPart ;
        rdfs:label "Has part" ;
        sh:order 100 ;
    ] ;
    sh:property [
        sh:path era:inCountry ;
        rdfs:label "In country" ;
        sh:order 110 ;
    ] ;
    sh:property [
        sh:path era:infrastructureManager ;
        rdfs:label "Infrastructure manager" ;
        sh:node xp:full-OrganisationRole ;
        sh:order 120 ;
    ] ;
    sh:property [
        sh:path era:isPartOf ;
        rdfs:label "Is part of" ;
        sh:order 130 ;
    ] ;
    sh:property [
        sh:path era:maxbridgeWind ;
        rdfs:label "Maximun bridge wind" ;
        sh:datatype xsd:integer ;
        sh:order 140 ;
    ] ;
    sh:property [
        sh:path era:netReference ;
        rdfs:label "Net reference" ;
        sh:order 150 ;
    ] ;
    sh:property [
        sh:path ( era:netReference <http://www.opengis.net/ont/geosparql#hasGeometry> <http://www.opengis.net/ont/geosparql#asWKT> ) ;
        rdfs:label "Net reference / Geometry / WKT" ;
        sh:order 160 ;
    ] ;
    sh:property [
        sh:path era:notApplicable ;
        rdfs:label "Not applicable" ;
        sh:order 170 ;
    ] ;
    sh:property [
        sh:path era:notYetAvailable ;
        rdfs:label "Not provided" ;
        sh:order 180 ;
    ] ;
    sh:property [
        sh:path era:openingHoursLimitation ;
        rdfs:label "Opening hours limitation" ;
        sh:datatype xsd:string ;
        sh:order 190 ;
    ] ;
    sh:property [
        sh:path era:parameterApplicability ;
        rdfs:label "Parameter applicability" ;
        sh:node xp:full-ParameterApplicability ;
        sh:order 200 ;
    ] ;
    sh:property [
        sh:path era:primaryLocation ;
        rdfs:label "Primary location" ;
        sh:order 210 ;
    ] ;
    sh:property [
        sh:path era:validity ;
        rdfs:label "Validity" ;
        sh:order 220 ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/2000/01/rdf-schema#label> ;
        rdfs:label "Label" ;
        sh:datatype <http://www.w3.org/1999/02/22-rdf-syntax-ns#langString> ;
        sh:order 230 ;
    ] .

