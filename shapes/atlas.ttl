# RINF Atlas shape vocabulary.
#
# Facet shapes are plain SHACL node shapes plus a handful of atlas:
# annotations. The worker reads every *.ttl file in this folder:
#
#   one sh:NodeShape per class shown on the map  (atlas:key required)
#   sh:property shapes with atlas:facet          become facets
#
# Class-level annotations
#   atlas:key           stable id used in URLs and the database ("operational-point")
#   rdfs:label          name shown in the UI
#   atlas:color         hex colour on the map
#   atlas:order         sort order in the class list
#   atlas:geometry      "point" | "line" | "any" (rendering hint only)
#   atlas:minZoom       map zoom from which the class is drawn
#   atlas:drawOrder     integer; among features drawn alike (points, lines,
#                       areas) higher numbers are drawn on top. Classes without
#                       one go below, earlier in the class list on top. Points
#                       are always drawn over lines, lines over areas.
#   atlas:shared true   facets of this shape apply to every class; it has no
#                       sh:targetClass of its own and is not drawn
#   atlas:enabled false skip the shape without deleting it
#
# Geometry, tried in this order until one gives a result:
#   atlas:geometryPath  SHACL path to a GeoSPARQL WKT literal
#                       (the branches of an sh:alternativePath are tried in
#                       list order, the first with a geometry wins: the
#                       shapes prefer era:netReference's geometry over the
#                       feature's own)
#   atlas:lineBetween   ( pathA pathB ) straight line between the geometries
#                       of the indexed features reached by both paths
#   atlas:geometryFrom  SHACL path to other indexed features whose geometry is
#                       copied (several are merged into one multi-geometry)
#
# Label: atlas:labelPath (SHACL path, several allowed, first hit wins),
# default rdfs:label.
#
# Property-level annotations (inside sh:property)
#   sh:path             any SHACL path (sequence, inverse, alternative, *, +, ?)
#   atlas:facet         facet key; reuse the same key in several shapes to share
#                       one facet across classes
#   rdfs:label / sh:name  facet label
#   atlas:kind          "terms" (default) | "range" | "boolean" | "text" | "link"
#                       text = only added to full-text search, no facet
#                       link = IRIs of other indexed features (start/end
#                       operational point of a section); stored and shown in
#                       the detail panel and exports, not offered as a
#                       filter. The line profile chains sections with these.
#                       (What a feature is part of needs no link facet: the
#                       atlas:geometryFrom links are kept for every feature.)
#   sh:datatype         optional; used for range formatting
#   sh:order            facet order in the panel
#   atlas:colorBy       integer; suggest the facet in the map's "Colour by"
#                       picker, lower numbers first (every terms, boolean and
#                       range facet can colour the map; these are listed first)
#   atlas:colorClasses  range facets only: fixed map colour classes instead of
#                       ones computed from the data, an RDF list low to high of
#                       [ atlas:upTo 40 ; rdfs:label "Very low speed" ] (upTo is
#                       the class's inclusive upper bound) ending with one
#                       class without atlas:upTo for every higher value; 2 to 8
#                       classes, rdfs:label optional
#
# Vehicle compatibility rules (shapes/compatibility.ttl): a sh:NodeShape with
#   atlas:compatibility true   marks the rule shape (at most one; no atlas:key)
#   atlas:trackClass    class key(s) whose features are the tracks of a section
#   atlas:sectionClass  class key of the sections of line (default "section-of-line")
# and per sh:property (one vehicle characteristic):
#   sh:path             the characteristic's ERA property from era:VehicleType
#                       (an IRI or a sequence of IRIs; used for Turtle export)
#   atlas:characteristic  key in vehicle profiles and the API
#   atlas:compareTo     infrastructure facet key(s) compared with (repeatable)
#   atlas:constraint    sh:hasValue | sh:in | sh:minInclusive | sh:maxInclusive |
#                       sh:minExclusive | sh:maxExclusive, applied to the
#                       infrastructure values with the vehicle value(s)
#   atlas:appliesTo     "track" (default) | "section"
#   atlas:unit          unit of the number the user enters
#   atlas:whenMissing   atlas:Unknown (default) | atlas:Incompatible: the result
#                       for a track without a value for the compared facets
#   atlas:noneValue     IRI the user can add to the vehicle's values meaning it
#                       also runs where the system is absent (e.g. "not
#                       electrified" for bi-mode): such tracks are compatible,
#                       and since the vehicle can do without the system, so is
#                       every other track for this rule and the rules naming it
#                       in noneFrom (a mismatch or missing value never fails)
#   atlas:noneFrom      characteristic key of the rule with atlas:noneValue that
#                       tells whether the system is absent; whenMissing and
#                       noneValue then apply only where it is absent, a missing
#                       value elsewhere stays unknown
#   atlas:missingReason short text shown for a track where the system is absent
#   rdfs:label, rdfs:comment, sh:datatype, sh:order, atlas:enabled false
#
# Views (shapes/views/*.ttl): a named lens on the map, picked from the top of the
# filter panel. One sh:NodeShape per view with
#   atlas:view          view key, used in links (vw=) and the API (required)
#   rdfs:label, rdfs:comment, sh:order, atlas:enabled false
#   atlas:viewClass     class key(s) the view selects
#   atlas:groupBy       facet key whose values the view is split by (corridor,
#                       country): the group picker and the rows of the
#                       requirements table
#   atlas:groupLabel    name of one group ("Corridor")
#   atlas:filter        [ atlas:facet key ; sh:in ( values ) ] filter set when
#                       the view opens (repeatable)
#   atlas:colorBy       facet or check key the map is coloured by
#   sh:property [ atlas:facet key ; sh:order n ]  the parameters listed first
#                       in the filter panel (existing facets, in this order)
# Requirement checks of a view: they compare facets the worker already indexed
# and are evaluated in PostgreSQL after every index update (no reindex when only
# a check changes). The result is stored as a facet of its own: atlas:Meets,
# atlas:NoData or atlas:DoesNotMeet; a feature the check does not apply to gets
# no value. So a check can be filtered on, colour the map and is exported.
#   atlas:checkClass    class key(s) checked on their own values (the tracks)
#   atlas:checkSection  class key whose features get the best result of their
#                       parts (atlas:geometryFrom links): a section of line meets
#                       a requirement when one of its tracks does
#   atlas:summaryCheck  key of the summary: the worst result of the checks that
#                       apply (default "<view>.all"; only with two checks or more)
#   atlas:summaryLabel  its label
# and per check, sh:property [ atlas:check key ; ... ] with
#   atlas:compareTo     facet key(s) compared (values pooled)
#   sh:hasValue v, ...  meets when one value is one of these
#   sh:in ( ... )       meets when every value is one of these
#   atlas:notIn ( ... ) meets when a value is none of these
#   sh:minInclusive | sh:maxInclusive | sh:minExclusive | sh:maxExclusive
#                       meets when no number breaks the bound; with
#                       atlas:termValue [ atlas:term IRI ; atlas:value n ] the
#                       compared values are concepts standing for a number, and
#                       it meets when one of them satisfies the bound
#   atlas:impliedValue  [ atlas:facet key ; atlas:when IRI ; atlas:value IRI ]:
#                       a feature whose facet holds `when` also has `value`
#                       (ETCS declared not applicable = no ETCS)
#   atlas:appliesWhen   [ atlas:facet key ; sh:in ( values ) ]: the check applies
#                       only to features with one of these values (repeatable,
#                       all must hold)
#   atlas:whenMissing   atlas:NoData (default) | atlas:DoesNotMeet: the result
#                       for a feature without a value
#   atlas:deadline      free text shown with the check ("core 2030")
#   atlas:unit          unit of the bound
#   rdfs:label, rdfs:comment, sh:order
PREFIX atlas: <https://rinf-atlas.matdata.eu/ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:   <http://www.w3.org/2002/07/owl#>

atlas: a owl:Ontology ; rdfs:label "RINF Atlas shape annotations" .

atlas:Unknown a rdfs:Resource ;
    rdfs:label "Unknown" ;
    rdfs:comment "atlas:whenMissing value: a track without a value makes the characteristic unknown (yellow)." .
atlas:Incompatible a rdfs:Resource ;
    rdfs:label "Incompatible" ;
    rdfs:comment "atlas:whenMissing value: a track without a value is not compatible (red)." .
atlas:Meets a rdfs:Resource ;
    rdfs:label "Meets the requirement" ;
    rdfs:comment "Result of a view check (shapes/views): the feature meets the requirement." .
atlas:NoData a rdfs:Resource ;
    rdfs:label "Data missing" ;
    rdfs:comment "Result of a view check: RINF does not declare the compared parameter. Also the default atlas:whenMissing of a check." .
atlas:DoesNotMeet a rdfs:Resource ;
    rdfs:label "Does not meet the requirement" ;
    rdfs:comment "Result of a view check: the feature does not meet the requirement. As atlas:whenMissing: a feature without a value does not meet it." .
