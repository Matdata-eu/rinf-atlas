# Host port of the web UI (nginx also proxies /api to the api service).
ATLAS_PORT=8080
POSTGRES_PASSWORD=change-me
PG_SHARED_BUFFERS=1GB
# Comma separated environment keys from config/environments.yaml: prod, uat (empty = all).
ATLAS_ENVS=
# Public address of this instance, used in the absolute links of the OGC API
# (/api/ogc) and TileJSON, and the canonical address for search engines. Set it
# when a TLS proxy sits in front of the web container, e.g.
# https://rinf-atlas.example.org; empty = from the request, and search engines
# are asked not to index the instance (docs/seo.md).
ATLAS_PUBLIC_URL=
# off = keep an instance with a public address out of search engines (test, UAT).
ATLAS_INDEXING=
# Only index these graphs (IM codes like 0088,0084 or full graph IRIs). Empty = everything.
ATLAS_ONLY_GRAPHS=
ATLAS_POLL_MINUTES=30
# Export jobs (docs/export.md): run by the worker from the mirror, files kept for
# ATLAS_EXPORT_RETENTION_HOURS. Empty ATLAS_EXPORT_MAX_ENTITIES = no cap on the
# number of entities per export; ATLAS_EXPORT_QUEUE caps the queued + running jobs.
ATLAS_EXPORT_WORKERS=2
ATLAS_EXPORT_RETENTION_HOURS=24
ATLAS_EXPORT_MAX_ENTITIES=
ATLAS_EXPORT_QUEUE=20
# Data quality: validate datasets against ERA's SHACL shapes (0 = off). Empty values use
# config/environments.yaml (15M triples, 60 minutes per dataset, ERA's mirrored shapes).
# Each takes one value for every environment or per environment: prod=v3.3.4,uat=v4.0.0
ATLAS_QUALITY=1
# Datasets with more triples are not validated (shown as "too large").
ATLAS_QUALITY_MAX_TRIPLES=
ATLAS_QUALITY_MINUTES=
# Pin the shapes to a tag of ERA's ontology repository on GitLab (`atlas shapes-tags`).
ATLAS_QUALITY_SHAPES_TAG=
# shacl-report instance the UI links to for exploring downloaded reports (empty = no link).
ATLAS_SHACL_REPORT_URL=https://shacl-report.matdata.eu/
# Where "Full describe" links point, e.g. a RINF Describe instance (github.com/Matdata-eu/rinf-describe).
# {iri} and {env} are replaced (URL encoded). Empty hides the link. An environment's
# describe_url in config/environments.yaml overrides it.
# ATLAS_DESCRIBE_URL=https://describe.example.org/describe?uri={iri}&env={env}
ATLAS_DESCRIBE_URL=
# Keys for the extra map layers in config/layers.yaml (docs/layers.md), referenced
# there as ${ATLAS_LAYER_...}. Layers using one are proxied by the API by default,
# so the key never reaches a browser.
# ATLAS_LAYER_BASEMAP_KEY=
# Published images (docker compose pull): registry/name prefix and version tag.
ATLAS_IMAGE=ghcr.io/matdata-eu/rinf-atlas
ATLAS_VERSION=latest
